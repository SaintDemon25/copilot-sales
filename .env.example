# ── Docker / nginx proxy mode (default) ──────────────────────────────────────
# Leave empty → all API calls are relative (/api/...) and go through nginx proxy
VITE_API_BASE_URL=

# ── Direct mode (npm run dev without Docker) ──────────────────────────────────
# Set to DialogScribe URL if running the frontend outside Docker
# VITE_API_BASE_URL=http://localhost:7860

# ── DialogScribe admin credentials (used for auto-login JWT) ─────────────────
# Must match ADMIN_EMAIL / ADMIN_PASSWORD in docker-compose.fullstack.yaml
VITE_DS_EMAIL=admin@local.dev
VITE_DS_PASSWORD=admin123

# ── Optional static API key (unused when JWT auto-login is active) ────────────
VITE_API_KEY=

# ── User display ──────────────────────────────────────────────────────────────
VITE_USER_NAME=
VITE_USER_ROLE=Менеджер продаж

# ── CalDAV (Yandex 360, Nextcloud, Radicale, etc.) ───────────────────────────
# Toggle "CalDAV" in Meetings screen to load real calendar events
VITE_CALDAV_URL=https://caldav.yandex.ru/calendars/user%40domain.ru/events-default/
VITE_CALDAV_USER=user@domain.ru
VITE_CALDAV_PASSWORD=app-password-here
